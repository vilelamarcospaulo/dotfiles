brew "neovim"

# fzf-lua shells out to these; they appear nowhere in the lua config, so
# don't prune them just because grep finds no reference.
brew "fzf"
brew "ripgrep"
brew "fd"

# language servers enabled in lua/core/lsp/init.lua — nvim has no mason, so
# every server here must exist on $PATH or it fails silently.
brew "lua-language-server"   # lua_ls
brew "pyright"               # pyright
brew "ruby-lsp"              # ruby-lsp
brew "vtsls"                 # vtsls
